<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.feeder.fetch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/reader/feeder/run-feeder.sh</string>
		<string>/Users/reader/bin/feeder</string>
		<string>/Users/reader/feeder/state</string>
		<string>UTC</string>
		<string>/Users/reader/feeder/digests</string>
		<string>fetch</string>
		<string>10s</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/reader/feeder/logs/fetch.jsonl</string>
	<key>StandardErrorPath</key>
	<string>/Users/reader/feeder/logs/fetch.err</string>
</dict>
</plist>
